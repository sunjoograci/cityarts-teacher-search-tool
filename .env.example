HUNTER_API_KEY=your_hunter_api_key_here

# --- Remote scraper service (only needed for the Vercel-hosted app) ---
# URL of the scrape_service.py deployment (e.g. Render), no trailing slash.
SCRAPER_SERVICE_URL=
# Shared secret required by both the Vercel app and the scraper service.
SCRAPE_SHARED_SECRET=

# --- scrape_service.py only (set these on the scraper host, e.g. Render) ---
GITHUB_TOKEN=
GITHUB_REPO=your-github-username/your-repo-name
GIT_USER_NAME=cityarts-scraper-bot
GIT_USER_EMAIL=scraper-bot@users.noreply.github.com
