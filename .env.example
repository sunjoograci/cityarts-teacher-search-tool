HUNTER_API_KEY=your_hunter_api_key_here

# --- Optional overrides (all have working defaults, uncomment to change) ---
# Path to the SQLite database file. Defaults to data/schools.db.
# DB_PATH=data/schools.db
# Number of concurrent Playwright browser contexts during scraping.
# SCRAPE_CONCURRENCY=2
# Local Flask port for app.py. Defaults to 5000.
# PORT=5000

# --- Remote scraper service (only needed for the Vercel-hosted app) ---
# URL of the scrape_service.py deployment (e.g. Render), no trailing slash.
SCRAPER_SERVICE_URL=
# Shared secret required by both the Vercel app and the scraper service.
SCRAPE_SHARED_SECRET=

# --- Remote ingest (only needed when running the scraper on a separate
# machine and pushing results into a central server's database instead of
# writing locally) ---
# REMOTE_INGEST_URL=
# REMOTE_INGEST_SECRET=

# --- scrape_service.py only (set these on the scraper host, e.g. Render) ---
GITHUB_TOKEN=
GITHUB_REPO=your-github-username/your-repo-name
GIT_USER_NAME=cityarts-scraper-bot
GIT_USER_EMAIL=scraper-bot@users.noreply.github.com
